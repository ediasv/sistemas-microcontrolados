<mxfile host="app.diagrams.net">
  <diagram name="DET - Jogo de Adivinhacao" id="det">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Lab 2 - Jogo de Adivinhacao (DET)&lt;/b&gt;&lt;br&gt;ISR Timer0A (1 ms): se contando, ms++; a cada 1000 ms, segundos++" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="560" height="50" as="geometry" />
        </mxCell>

        <mxCell id="init" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="90" y="175" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s_ag" value="&lt;b&gt;AGUARDANDO&lt;/b&gt;&lt;hr&gt;LCD: &quot;Adivinhe: 0-99&quot;&lt;br&gt;tempo parado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
