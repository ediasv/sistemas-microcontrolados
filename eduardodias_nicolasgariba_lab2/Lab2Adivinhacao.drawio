          <mxGeometry x="560" y="440" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s_ac" value="&lt;b&gt;ACERTOU&lt;/b&gt;&lt;hr&gt;L1: &quot;ACERTOU! N=SS&quot;&lt;br&gt;L2: &quot;Tent:NN T:TTTs&quot;&lt;br&gt;tempo parado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="290" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e0" value="reset / power-on" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="init" target="s_ag">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="qualquer tecla (exceto A)&lt;br&gt;secreto = GPTMTAR % 100&lt;br&gt;tentativas = 0; tempo = 0; inicia tempo&lt;br&gt;(se for digito, ja entra no palpite)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;align=center;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_ag" target="s_dig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="0-9 (se &amp;lt; 2 digitos): palpite = palpite*10 + d&lt;br&gt;* : palpite = 0" style="html=1;endArrow=block;curved=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_dig" target="s_dig">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="90" />
              <mxPoint x="710" y="90" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" value="# (palpite != secreto)&lt;br&gt;tentativas++&lt;br&gt;dica = secreto &amp;gt; palpite ? MAIOR : MENOR" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_dig" target="s_dica">
          <mxGeometry relative="1" as="geometry">
