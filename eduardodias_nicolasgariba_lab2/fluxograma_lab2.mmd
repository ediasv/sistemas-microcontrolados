flowchart LR
  subgraph MAIN["Programa principal"]
    direction TB
    INI(["Início do programa principal"]) --> HW["Inicializar PLL, SysTick, portas GPIO e LCD"]
    HW --> TMR["Configurar Timer 0A periódico (1 ms) e habilitar interrupção"]
    TMR --> NP["Nova partida: parar contagem de tempo, zerar palpite e tentativas, estado = AGUARDANDO"]
    NP --> MSG["Limpar LCD e mostrar 'Adivinhe: 0-99' na linha 1"]
    MSG --> LER["Varrer teclado (debounce 150 ms e aguardar soltar a tecla)"]

    LER --> TEC{"Alguma tecla foi pressionada?"}
    TEC -- Não --> LER
    TEC -- Sim --> TA{"Tecla é A?"}
    TA -- Sim --> NP
    TA -- Não --> EAG{"Estado = AGUARDANDO?"}

    EAG -- Sim --> SORT["Sortear número secreto: valor do GPTMTAR mod 100"]
    SORT --> TINI["Zerar e iniciar contagem do tempo, estado = DIGITANDO"]
    TINI --> MOS1["Mostrar palpite e tentativas no LCD"]
    MOS1 --> NUM

    EAG -- Não --> EDICA{"Estado = MOSTRANDO_DICA?"}
    EDICA -- Sim --> TDIG{"Tecla é dígito (0-9) ou * ?"}
    TDIG -- Não --> LER
    TDIG -- Sim --> VOLTA["Zerar palpite, estado = DIGITANDO, mostrar palpite e tentativas no LCD"]
    VOLTA --> NUM

    EDICA -- Não --> EDIG{"Estado = DIGITANDO?"}
    EDIG -- "Não (ACERTOU)" --> LER
    EDIG -- Sim --> NUM{"Tecla é dígito (0-9)?"}

    NUM -- Sim --> LIM{"Palpite já tem 2 dígitos?"}
    LIM -- Sim --> LER
    LIM -- Não --> COMP["palpite = palpite x 10 + dígito"]
    COMP --> MP["Mostrar palpite no LCD"]
    MP --> LER

    NUM -- Não --> AST{"Tecla é * ?"}
    AST -- Sim --> APAGA["palpite = 0 (apagar palpite)"]
    APAGA --> MP

    AST -- Não --> HASH{"Tecla é #35; e há palpite digitado?"}
    HASH -- Não --> LER
    HASH -- Sim --> INC["tentativas += 1"]
    INC --> IGUAL{"Palpite = número secreto?"}

    IGUAL -- Sim --> ACERTO["Parar contagem do tempo, estado = ACERTOU"]
    ACERTO --> MAC["Mostrar 'ACERTOU! N=xx' e 'Tent:xx T:xxxs' no LCD"]
    MAC --> LER

    IGUAL -- Não --> MAIOR{"Número secreto > palpite?"}
    MAIOR -- Sim --> DMAIOR["estado = MOSTRANDO_DICA, mostrar palpite e 'Dica: MAIOR'"]
    MAIOR -- Não --> DMENOR["estado = MOSTRANDO_DICA, mostrar palpite e 'Dica: MENOR'"]
    DMAIOR --> LER
    DMENOR --> LER
  end

  subgraph INT["Interrupção do Timer 0A"]
    direction TB
    ISR(["Início do tratamento da interrupção do Timer 0A (a cada 1 ms)"]) --> ACK["Limpar flag de interrupção do timer"]
    ACK --> CONT{"Partida em andamento?"}
    CONT -- Não --> FIM(["Fim do tratamento de interrupção"])
    CONT -- Sim --> MS["ms_contador += 1"]
    MS --> SEG{"ms_contador = 1000?"}
    SEG -- Não --> FIM
    SEG -- Sim --> INCS["ms_contador = 0, segundos_jogo += 1"]
    INCS --> FIM
  end

    MAIN ~~~ INT

    %% ================= ESTILO =================
    classDef inicio fill:#c9dcf8,stroke:#333,stroke-width:2px,color:#000
    classDef fim fill:#f6c9a8,stroke:#333,stroke-width:2px,color:#000
    classDef processo fill:#ffffff,stroke:#333,stroke-width:2px,color:#000
    classDef decisao fill:#fff3a8,stroke:#333,stroke-width:2px,color:#000

    class INI,ISR inicio
    class FIM fim
    class HW,TMR,NP,MSG,LER,SORT,TINI,MOS1,VOLTA,COMP,MP,APAGA,INC,ACERTO,MAC,DMAIOR,DMENOR,ACK,MS,INCS processo
    style MAIN fill:#ffffff,stroke:#999,stroke-dasharray:5 5
    style INT fill:#ffffff,stroke:#999,stroke-dasharray:5 5
    class TEC,TA,EAG,EDICA,TDIG,EDIG,NUM,LIM,AST,HASH,IGUAL,MAIOR,CONT,SEG decisao
